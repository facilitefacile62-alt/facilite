# .env.example
# Copy this file to .env and fill in your credentials

# Supabase PostgreSQL connection URL (e.g., postgresql://user:password@host:5432/dbname)
SUPABASE_DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>

# Supabase service role key (for admin API access)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FastAPI secret key (optional, for JWT etc.)
FASTAPI_SECRET_KEY=your-secret-key

# Optional: API base URL for Supabase REST client
SUPABASE_API_URL=https://<project>.supabase.co/rest/v1/

# Optional: Supabase anon/public key (if using client libraries)
SUPABASE_ANON_KEY=your-anon-key
