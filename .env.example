# Copier ce fichier vers .env.local (dev) et renseigner les vraies valeurs.
# Ne jamais commiter de vraies clés — .env* est ignoré par git (voir .gitignore).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : contourne RLS, réservée aux traitements serveur
# (webhook de paiement, génération de facture). Ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (cascade Groq -> Gemini -> DeepSeek, dégrade proprement si absentes) ---
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Google Cloud Vision (OCR) ---
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- KPay (https://kpay.site) — paiement de la confection de CV (1 500 / 2 000 FCFA) ---
# Clé publique (X-API-Key). Préfixe kpay_test_ (sandbox) ou kpay_live_ (production).
NEXT_PUBLIC_KPAY_PUBLIC_KEY=
# Clé secrète (X-Secret-Key). Ne jamais exposer côté client malgré le nom
# "clé publique" ci-dessus : la doc KPay est explicite, les deux clés
# "ne voyagent que de serveur à serveur".
KPAY_SECRET_KEY=
# Secret utilisé pour vérifier la signature HMAC-SHA256 du webhook
# (header X-KPAY-Signature). À récupérer depuis le tableau de bord KPay —
# distinct de KPAY_SECRET_KEY.
KPAY_WEBHOOK_SECRET=
# URL publique de l'application, utilisée pour construire returnUrl/cancelUrl
# côté KPay et l'URL du webhook (jamais localhost en production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Notifications (facultatif, dégrade proprement si absentes) ---
RESEND_API_KEY=
RESEND_FROM_BILLING=
RESEND_TEST_RECIPIENT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Protège /api/cron/reminders (relances automatiques, voir vercel.json).
# Vercel envoie "Authorization: Bearer $CRON_SECRET" à ses propres appels
# cron dès que cette variable existe sur le projet — générer une valeur
# aléatoire (ex. `openssl rand -hex 32`), jamais réutiliser un autre secret.
CRON_SECRET=
