# Copier ce fichier vers .env.local (dev) et renseigner les vraies valeurs.
# Ne jamais commiter de vraies clés — .env* est ignoré par git (voir .gitignore).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : contourne RLS, réservée aux traitements serveur
# (webhook de paiement, génération de facture). Ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (cascade Groq -> Gemini -> DeepSeek, dégrade proprement si absentes) ---
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Google Cloud Vision (OCR) ---
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- KPay (https://kpay.site) — paiement de la confection de CV (1 500 / 2 000 FCFA) ---
# Clé publique (X-API-Key). Préfixe kpay_test_ (sandbox) ou kpay_live_ (production).
NEXT_PUBLIC_KPAY_PUBLIC_KEY=
# Clé secrète (X-Secret-Key). Ne jamais exposer côté client malgré le nom
# "clé publique" ci-dessus : la doc KPay est explicite, les deux clés
# "ne voyagent que de serveur à serveur".
KPAY_SECRET_KEY=
# Secret utilisé pour vérifier la signature HMAC-SHA256 du webhook
# (header X-KPAY-Signature). À récupérer depuis le tableau de bord KPay —
# distinct de KPAY_SECRET_KEY.
KPAY_WEBHOOK_SECRET=
# URL publique de l'application, utilisée pour construire returnUrl/cancelUrl
# côté KPay et l'URL du webhook (jamais localhost en production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Orange Money "Paiement Marchand" (QR code/deeplink) — abonnement Premium ---
# Toujours le sandbox par défaut (voir src/lib/orangeMoney.js) : basculer en
# production est un choix explicite, jamais un effet de bord de NODE_ENV.
ORANGE_MONEY_API_BASE_URL=https://api.sandbox.orange-sonatel.com
# Identifiants OAuth2 (client_credentials), obtenus sur le portail développeur.
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
# Code marchand à 6 chiffres (champ "code" de /api/eWallet/v4/qrcode) —
# DISTINCT de ORANGE_MONEY_CLIENT_ID. À obtenir auprès du contact Orange
# Sonatel (portail développeur ou support OFMS) avant d'activer le paiement
# en production : tant que cette variable est vide, la génération de QR
# code échoue explicitement plutôt que d'envoyer une valeur inventée.
ORANGE_MONEY_MERCHANT_CODE=
# Secret utilisé pour vérifier la signature HMAC-SHA256 du webhook
# (header X-Sonatel-Signature). Distinct de ORANGE_MONEY_CLIENT_SECRET —
# probablement l'"apiKey" choisi lors de l'enregistrement du callback via
# POST /api/notification/v1/merchantcallback, à confirmer en testant.
ORANGE_MONEY_WEBHOOK_SECRET=

# --- Notifications (facultatif, dégrade proprement si absentes) ---
RESEND_API_KEY=
RESEND_FROM_BILLING=
RESEND_TEST_RECIPIENT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- SMS OTP (inscription/connexion par téléphone, Supabase Auth natif) ---
# Compte Twilio DISTINCT du bloc ci-dessus : celui-ci ne sert qu'à la
# notification WhatsApp d'achat de CV (src/lib/notifications.js), jamais à
# l'authentification. Jamais réutiliser TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN
# ici — deux usages, deux comptes/identifiants, jamais mélangés. Lu par
# Supabase (fournisseur SMS du provider Phone), jamais par le code
# applicatif directement.
TWILIO_OTP_ACCOUNT_SID=
TWILIO_OTP_AUTH_TOKEN=
TWILIO_OTP_MESSAGING_SERVICE_SID=

# Protège /api/cron/reminders (relances automatiques, voir vercel.json).
# Vercel envoie "Authorization: Bearer $CRON_SECRET" à ses propres appels
# cron dès que cette variable existe sur le projet — générer une valeur
# aléatoire (ex. `openssl rand -hex 32`), jamais réutiliser un autre secret.
CRON_SECRET=
