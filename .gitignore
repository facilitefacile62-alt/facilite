# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright E2E — un trace.zip contient des requêtes réseau en clair,
# tokens de session compris (voir docs/diagnostic-2026-08.md, JWT expiré
# trouvé dans l'historique via un commit de trace) : jamais suivi.
/test-results/
test-results/
/playwright-report/
playwright-report/
/blob-report/
/playwright/.cache/
**/trace.zip

# Config Claude Code locale à ce dépôt — jamais committée (règle
# permanente, voir CLAUDE.md) : une permission trop large ou un réglage de
# session ne doit jamais passer inaperçu dans l'historique. settings.json
# était suivi jusqu'ici ; il a été retiré du suivi git (git rm --cached)
# sans être supprimé du disque.
.claude/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# fichiers d'identifiants telecharges depuis les consoles cloud
client_secret_*.json
*credentials*.json
*-service-account*.json

# sauvegardes chiffrées (4D, docs/sauvegarde-restauration.md) — chiffrées
# avant tout, mais aucune raison qu'elles transitent par git en plus
*.enc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
# .env.example ne contient aucun secret (valeurs vides, gabarit à copier
# vers .env.local) — sûr à committer, contrairement aux autres .env*.
!.env.example
client_secret_*.json

# Python & Backend SQLite DB
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.db
.pytest_cache/
venv/
env/

# Dump de schéma de prod (ne jamais commiter l'infrastructure réelle)
supabase/test-schema-dump*
scripts/prod-schema-dump.sql
scripts/prod-schema-dump.functions.json
